---
interface Props {
  href: string;
  external?: boolean;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, external = false, variant = 'primary', class: className = '' } = Astro.props;

const base = 'inline-flex items-center justify-center rounded-xl px-5 py-3 text-sm font-semibold transition focus:outline-none focus:ring-2 focus:ring-offset-2';
const styles = variant === 'primary'
  ? 'bg-blue-600 text-white hover:bg-blue-700 focus:ring-blue-600'
  : 'bg-white text-blue-700 border border-blue-200 hover:bg-blue-50 focus:ring-blue-400';
---

<a
  href={href}
  class={`${base} ${styles} ${className}`}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
</a>