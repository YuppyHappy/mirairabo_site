---
import { getCollection } from 'astro:content';
import Card from '../ui/Card.astro';

const reports = (await getCollection('reports')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<section class="mx-auto max-w-6xl px-6 py-16">
  <div class="reveal opacity-0">
    <h2 class="text-2xl font-bold text-blue-900 md:text-3xl">活動報告</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {reports.map((r) => (
        <Card>
          {r.data.cover && <img src={r.data.cover} alt={r.data.title} class="mb-3 h-40 w-full rounded-xl object-cover" loading="lazy" />}
          <p class="text-xs text-slate-500">{r.data.date.toLocaleDateString('ja-JP')}</p>
          <h3 class="mt-1 text-lg font-semibold">{r.data.title}</h3>
          {r.data.summary && <p class="mt-2 text-sm text-slate-600">{r.data.summary}</p>}
        </Card>
      ))}
    </div>
  </div>
</section>