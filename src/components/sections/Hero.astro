---
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
---

<section class="relative overflow-hidden bg-gradient-to-br from-blue-700 via-blue-600 to-sky-500 text-white">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="reveal opacity-0">
      <p class="text-sm font-semibold uppercase tracking-widest text-blue-100">{site.name}</p>
      <h1 class="mt-4 text-4xl font-bold leading-tight md:text-6xl">{site.title}</h1>
      <p class="mt-6 max-w-2xl text-lg text-blue-50">{site.description}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={site.formUrl} external variant="secondary">活動に申し込む</Button>
      </div>
    </div>
  </div>
</section>