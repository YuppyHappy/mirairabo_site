---
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
---

<section class="mx-auto max-w-6xl px-6 py-20">
  <div class="reveal opacity-0">
    <p class="text-sm font-semibold uppercase tracking-widest text-slate-500">{site.name}</p>
    <h1 class="mt-4 text-4xl font-bold leading-tight md:text-6xl">{site.title}</h1>
    <p class="mt-6 max-w-2xl text-lg text-slate-600">{site.description}</p>
    <div class="mt-8">
      <Button href={site.formUrl} external variant="primary">活動に申し込む</Button>
    </div>
  </div>
</section>