---
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
---

<section class="mx-auto max-w-6xl px-6 py-20">
  <div class="reveal opacity-0 rounded-3xl bg-slate-900 px-8 py-16 text-center text-white">
    <h2 class="text-2xl font-bold md:text-3xl">活動に参加しませんか？</h2>
    <p class="mt-4 text-slate-300">Google フォームからお申し込みください。</p>
    <div class="mt-8">
      <Button href={site.formUrl} external variant="secondary">申し込みフォームを開く</Button>
    </div>
  </div>
</section>