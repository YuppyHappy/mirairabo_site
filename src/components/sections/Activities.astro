---
import { site } from '../../data/site';
import Card from '../ui/Card.astro';
---

<section class="mx-auto max-w-6xl px-6 py-16">
  <div class="reveal opacity-0">
    <h2 class="text-2xl font-bold text-blue-900 md:text-3xl">活動紹介</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {site.activities.map((a) => (
        <Card>
          <h3 class="text-lg font-semibold">{a.title}</h3>
          <p class="mt-2 text-sm text-slate-600">{a.description}</p>
        </Card>
      ))}
    </div>
  </div>
</section>